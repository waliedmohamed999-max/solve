{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "sh scripts/vercel-install.sh",
  "buildCommand": "npm run build:assets",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/services/(.*)",
      "dest": "/public/services/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|mjs|map|png|jpg|jpeg|gif|webp|svg|ico|txt|xml|json|webmanifest|woff|woff2|ttf|eot))",
      "dest": "/public/$1"
    },
    {
      "src": "/.*",
      "dest": "/api/index.php"
    }
  ]
}
